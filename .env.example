# Copy to .env.local. Never commit real credentials.
YT_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3939/api/spotify/callback

# Python interpreter with yt-dlp installed.
# Set an absolute path if python is not available on PATH.
PYTHON_PATH=python
DL_PORT=3941
